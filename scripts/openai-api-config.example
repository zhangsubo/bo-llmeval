# 复制为同目录 openai-api-config，再填写常用配置。
# 四种接口共用配置格式；运行时选择 chat/completions、responses、video 或 seedance。
# seedance 为火山方舟原生协议；请单独添加方舟配置，Base URL 为 https://ark.cn-beijing.volces.com/api/v3。
# 每组 BASE_URL 和 API_KEY 必须同时填写；空白组不会出现在选择菜单。
# 复制以下三行并将编号改为 3、4……即可添加更多组。
# 值按字面读取，不执行 shell、不展开环境变量；可使用单引号或双引号。

NAME1="常用配置一"
BASE_URL1=
API_KEY1=

NAME2="常用配置二"
BASE_URL2=
API_KEY2=

# AI 结果解读专用大模型配置（独立于被测配置，支持任意 OpenAI 兼容 chat/completions 接口）
ANALYZER_NAME="AI 结果解读模型"
ANALYZER_BASE_URL=
ANALYZER_API_KEY=
ANALYZER_MODEL=

# 1Password CLI 的账号与保险库（名称或 ID）；不填写任何登录令牌。
ONEPASSWORD_ACCOUNT=
ONEPASSWORD_VAULT=
# 在 Web 保存后 API_KEY1 / ANALYZER_API_KEY 自动写为 op://vault/item/credential。
# 本文件只保存引用，不填写真实 API Key；临时 CLI 测试可继续通过环境变量提供。
