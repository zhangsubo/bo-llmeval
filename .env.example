# 示例环境变量——复制为 .env 后使用；.env 绝不入库
# 数据库连接串（本地开发指向 compose db 服务）
DATABASE_URL=postgresql+psycopg://evalplat:evalplat@localhost:5432/evalplat
# 测试库连接串（指向 compose db-test 服务）
TEST_DATABASE_URL=postgresql+psycopg://evalplat:evalplat@localhost:5433/evalplat_test
# 应用主密钥（供 Phase 2/10 加密 API Key 使用，本阶段不使用）
APP_MASTER_KEY=change-me-in-production
# 日志级别
LOG_LEVEL=INFO
