# 示例环境变量——复制为 .env 后使用；.env 绝不入库
# 生产环境请通过 secret manager 注入全部凭据，并设置 APP_ENV=production。
APP_ENV=development
POSTGRES_USER=evalplat_dev
POSTGRES_PASSWORD=replace-with-random-local-password
POSTGRES_DB=evalplat
# 数据库连接串（本地开发直连 compose db；请替换密码占位符）
DATABASE_URL=postgresql+psycopg://evalplat_dev:replace-with-random-local-password@localhost:5432/evalplat
# 测试库连接串（指向 compose db-test 服务）
TEST_DATABASE_URL=postgresql+psycopg://evalplat_dev:replace-with-random-local-password@localhost:5433/evalplat_test
# 应用主密钥（必须替换为随机 Fernet key）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_MASTER_KEY=replace-with-generated-fernet-key
# 日志级别
LOG_LEVEL=INFO
# 数据集上传与缓存目录
DATASET_DIR=./data/datasets
EVALSCOPE_DIR=./data/evalscope
TOKENIZER_DIR=./data/tokenizers
# 清理批次无心跳后的自动恢复阈值（秒）
HISTORY_CLEANUP_STALE_SECONDS=900
# Code sandbox image. In production use a trusted registry image pinned by
# digest, for example: registry.example.com/python@sha256:<64-hex-digest>
SANDBOX_IMAGE=python:3.11-slim@sha256:9534e5a8e315485d4061ed659af0fd78a284c015f9b73661b41d6bab25604534
# Reject mutable sandbox tags in production deployments.
SANDBOX_REQUIRE_IMMUTABLE_IMAGE=false
# Optional absolute host path for Docker-socket sandbox bind mounts. Compose
# defaults this to ${PWD}/data/sandboxes; override it when the daemon cannot
# see the Compose project directory (for example on a remote Docker host).
# SANDBOX_HOST_DIR=/absolute/path/to/project/data/sandboxes
# SANDBOX_WORK_DIR=/sandbox
# Numeric group owning /var/run/docker.sock. Docker Desktop commonly uses 0;
# on Linux check with `stat -c %g /var/run/docker.sock` and override as needed.
DOCKER_GID=0
